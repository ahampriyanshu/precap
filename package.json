{
  "name": "precap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-runtime.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-runtime.mjs && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check app components hooks lib scripts tests public/python.worker.js package.json guides.json cheatsheets.json tsconfig.json next.config.ts playwright.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/view": "^6.38.6",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@uiw/react-codemirror": "4.25.12",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "shiki": "4.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
